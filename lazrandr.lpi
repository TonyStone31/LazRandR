<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="LazRandR"/>
      <Scaled Value="True"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
      <XPManifest>
        <DpiAware Value="True"/>
      </XPManifest>
      <Icon Value="0"/>
    </General>
    <MacroValues Count="1">
      <Macro1 Name="LCLWidgetType" Value="gtk3"/>
    </MacroValues>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <DestinationDirectory Value="$(ProjPath)/published/"/>
      <OpenInFileMan Value="True"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="BGRAControls"/>
      </Item>
      <Item>
        <PackageName Value="BGRABitmapPack"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="lazrandr.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="ufrmmain.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="frmMain"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
        <UnitName Value="ufrmMain"/>
      </Unit>
      <Unit>
        <Filename Value="ufrmscriptpreview.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="frmScriptPreview"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
        <UnitName Value="ufrmScriptPreview"/>
      </Unit>
      <Unit>
        <Filename Value="ufrmidentify.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="frmIdentify"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
        <UnitName Value="ufrmIdentify"/>
      </Unit>
      <Unit>
        <Filename Value="udisplaytypes.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uDisplayTypes"/>
      </Unit>
      <Unit>
        <Filename Value="uxrandr.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uXRandR"/>
      </Unit>
      <Unit>
        <Filename Value="utouch.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uTouch"/>
      </Unit>
      <Unit>
        <Filename Value="utheme.pas"/>
        <IsPartOfProject Value="True"/>
